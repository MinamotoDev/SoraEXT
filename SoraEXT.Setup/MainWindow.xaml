<Window x:Class="SoraEXT.Setup.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="Transparent" Padding="32" RowSpacing="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="150"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Grid ColumnSpacing="16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="8">
    <TextBlock Text="SoraEXT" Style="{ThemeResource TitleTextBlockStyle}"/>
    <TextBlock Text="0.1.0-release · Windows x64" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </StackPanel>
   <Image Grid.Column="1" Source="ms-appx:///Assets/SoraEXT.png" MaxWidth="180" Height="150"
     Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="SoraEXT"/>
  </Grid>
  <Grid Grid.Row="1">
    <ProgressBar x:Name="Progress" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Bottom"/>
  </Grid>
  <StackPanel Grid.Row="2" Spacing="16">
   <StackPanel Spacing="8">
     <Grid MinHeight="32">
      <TextBlock x:Name="Status" TextWrapping="Wrap" IsTextSelectionEnabled="True"
        VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
     </Grid>
     <HyperlinkButton x:Name="LicenseLink" MinHeight="32" Padding="0" Click="ShowLicense"/>
     <CheckBox x:Name="Agreement" MinHeight="32" IsChecked="False" Checked="AgreementChanged" Unchecked="AgreementChanged"/>
   </StackPanel>
   <Grid>
    <TextBlock x:Name="PoweredBy" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
     <Button x:Name="Cancel" Click="CancelClick"/>
     <Button x:Name="Action" Style="{ThemeResource AccentButtonStyle}" IsEnabled="False" Click="ActionClick"/>
    </StackPanel>
   </Grid>
  </StackPanel>
 </Grid>
</Window>
