<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SoraEXT.App</RootNamespace>
    <AssemblyName>SoraEXT</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Assets\SoraEXT.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>app.minamotodev.soraext</ApplicationId>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\Assets\SoraEXT.ico" Link="Assets\SoraEXT.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AssemblyMetadata Include="ReleaseChannel" Value="$(ReleaseChannel)" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <ProjectReference Include="..\SoraEXT.Core\SoraEXT.Core.csproj" />
  </ItemGroup>
  <!-- Unpackaged CLI publishing must carry the application's compiled XAML index. -->
  <Target Name="PublishApplicationResources" AfterTargets="Publish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')"
           Text="The application's compiled XAML resource index is missing." />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
