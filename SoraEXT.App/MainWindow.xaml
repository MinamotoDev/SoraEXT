<Window x:Class="SoraEXT.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:SoraEXT.Core"
    xmlns:local="using:SoraEXT.App"
    Title="SoraEXT">
    <Grid x:Name="Root" Loaded="OnLoaded" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Background="Transparent" Padding="20,0,160,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xEDA2;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="SoraEXT" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="SessionLabel" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto"
            OpenPaneLength="220" CompactModeThresholdWidth="640" ExpandedModeThresholdWidth="1100"
            IsBackButtonVisible="Collapsed" IsSettingsVisible="True" AlwaysShowHeader="False"
            IsTitleBarAutoPaddingEnabled="False" SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="VolumesNav" local:Translate.Key="分区" Tag="volumes">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem local:Translate.Key="运行记录" Tag="activity">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid Padding="24,16,24,24" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="PageTitle" local:Translate.Key="分区" Style="{ThemeResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="PageSubtitle" Visibility="Collapsed" Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                        <Button x:Name="AdminButton" Click="OnElevate" local:Translate.Tip="以管理员身份管理"
                                local:Translate.Name="以管理员身份管理">
                            <FontIcon Glyph="&#xEA18;" FontSize="18" />
                        </Button>
                        <Button x:Name="RefreshButton" Click="OnRefresh" local:Translate.Tip="刷新 (F5)"
                                local:Translate.Name="刷新">
                            <Button.KeyboardAccelerators><KeyboardAccelerator Key="F5" Invoked="OnRefreshKey" /></Button.KeyboardAccelerators>
                            <FontIcon Glyph="&#xE72C;" FontSize="18" />
                        </Button>
                    </StackPanel>
                </Grid>
                <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational" />
                <Grid x:Name="VolumesPanel" Grid.Row="2" RowSpacing="16" SizeChanged="OnVolumesSizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE9D9;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Name="SummaryTitle" local:Translate.Key="正在读取分区" FontWeight="SemiBold" />
                                <TextBlock x:Name="SummaryDetail" local:Translate.Key="由 Ext4Fsd 驱动" Style="{StaticResource SecondaryText}" FontSize="12" />
                            </StackPanel>
                            <TextBlock x:Name="MountCount" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" x:Name="Workspace" ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ListColumn" Width="*" />
                            <ColumnDefinition x:Name="DetailColumn" Width="360" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="ListRow" Height="*" />
                            <RowDefinition x:Name="DetailRow" Height="0" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <ListView x:Name="VolumeList" ItemsSource="{x:Bind Volumes}"
                                SelectionMode="Single" SelectionChanged="OnVolumeSelected"
                                HorizontalContentAlignment="Stretch" local:Translate.Name="分区"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                IsItemClickEnabled="False">
                                <ListView.Resources>
                                    <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                                </ListView.Resources>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Margin" Value="0,0,20,8" />
                                        <Setter Property="Padding" Value="8" />
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:VolumeRow">
                                        <Grid Padding="8,12" ColumnSpacing="16" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="48" Height="48" CornerRadius="8"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top">
                                                <FontIcon Glyph="&#xEDA2;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                                <ProgressBar Value="{x:Bind UsedPercent, Mode=OneWay}" Maximum="100" Height="3" Margin="0,4,0,2"
                                                    local:Translate.Name="已用空间" />
                                                <TextBlock Text="{x:Bind FreeSpaceText, Mode=OneWay}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="8" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind DisplayLetter, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                <TextBlock Text="{x:Bind State, Mode=OneWay}" FontSize="12" Style="{StaticResource SecondaryText}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="12"
                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEDA2;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock local:Translate.Key="暂无分区" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyDetail" local:Translate.Key="连接磁盘后刷新" Style="{StaticResource SecondaryText}" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <Border x:Name="DetailCard" Grid.Column="1" Style="{StaticResource Card}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="12" Margin="0,0,20,0">
                                    <TextBlock x:Name="DetailTitle" local:Translate.Key="选择分区" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                    <StackPanel x:Name="DetailFields" Spacing="12" Visibility="Collapsed">
                                        <StackPanel Spacing="6">
                                            <TextBlock local:Translate.Key="文件系统" Style="{StaticResource SecondaryText}" FontSize="12" />
                                            <TextBlock x:Name="DetailFileSystem" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="6">
                                                <TextBlock local:Translate.Key="盘符" Style="{StaticResource SecondaryText}" FontSize="12" />
                                                <TextBlock x:Name="DetailLetter" FontSize="20" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock local:Translate.Key="访问" Style="{StaticResource SecondaryText}" FontSize="12" />
                                                <TextBlock x:Name="DetailMode" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Spacing="6">
                                            <TextBlock local:Translate.Key="容量" Style="{StaticResource SecondaryText}" FontSize="12" />
                                            <TextBlock x:Name="DetailSize" Style="{StaticResource DetailText}" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock local:Translate.Key="挂载" Style="{StaticResource SecondaryText}" FontSize="12" />
                                            <TextBlock x:Name="DetailAuto" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock x:Name="DetailIdentityLabel" Text="UUID" Style="{StaticResource SecondaryText}" FontSize="12" />
                                            <TextBlock x:Name="DetailUuid" Style="{StaticResource DetailText}" FontFamily="Consolas" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock x:Name="DetailFeatures" Style="{StaticResource SecondaryText}" FontSize="12" />
                                        <Button x:Name="OpenButton" local:Translate.Key="在文件资源管理器中打开" Click="OnOpen"
                                            HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                                        <Grid x:Name="ManagementActions" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Button x:Name="ConfigureButton" local:Translate.Key="挂载" Click="OnConfigure" HorizontalAlignment="Stretch" />
                                            <Button x:Name="UnmountButton" Grid.Column="1" local:Translate.Key="卸载" Click="OnUnmount" HorizontalAlignment="Stretch" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
                <Grid x:Name="ActivityPanel" Grid.Row="2" Visibility="Collapsed">
                    <ListView x:Name="ActivityList" ItemsSource="{x:Bind Activity}" SelectionMode="None"
                              HorizontalContentAlignment="Stretch" local:Translate.Name="运行记录">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:LogEntry">
                                <Grid Padding="8,12" ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Time}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                   Style="{StaticResource SecondaryText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <ScrollViewer x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="0,0,20,0">
                        <TextBlock local:Translate.Key="语言" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock local:Translate.Key="应用语言" FontWeight="SemiBold" />
                                <ComboBox x:Name="LanguagePicker" MinWidth="220" HorizontalAlignment="Stretch"
                                          local:Translate.Name="应用语言" SelectionChanged="OnLanguageChanged">
                                    <ComboBoxItem local:Translate.Key="跟随系统" Tag="system" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="日本語" Tag="ja" />
                                    <ComboBoxItem Content="한국어" Tag="ko" />
                                    <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                                    <ComboBoxItem Content="正體中文" Tag="zh-Hant" />
                                </ComboBox>
                                <TextBlock local:Translate.Key="重启应用后生效" Style="{StaticResource SecondaryText}" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <TextBlock local:Translate.Key="外观" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock local:Translate.Key="主题" FontWeight="SemiBold" />
                                    <TextBlock local:Translate.Key="应用颜色" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                                <ComboBox x:Name="ThemePicker" Grid.Column="1" MinWidth="150" VerticalAlignment="Center"
                                          local:Translate.Name="主题" SelectionChanged="OnThemeChanged">
                                    <ComboBoxItem local:Translate.Key="跟随系统" Tag="Default" />
                                    <ComboBoxItem local:Translate.Key="浅色" Tag="Light" />
                                    <ComboBoxItem local:Translate.Key="深色" Tag="Dark" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock local:Translate.Key="云母背景" FontWeight="SemiBold" />
                                    <TextBlock local:Translate.Key="使用系统材质" Style="{StaticResource SecondaryText}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="BackdropSwitch" Grid.Column="1"
                                              local:Translate.Name="云母背景" Toggled="OnBackdropChanged" />
                            </Grid>
                        </Border>
                        <TextBlock local:Translate.Key="关于" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="AboutVersion" Text="SoraEXT" FontSize="18" FontWeight="SemiBold" />
                                <HyperlinkButton local:Translate.Key="Ext4Fsd 源代码" NavigateUri="https://github.com/bobranten/Ext4Fsd" Padding="0,8" HorizontalAlignment="Left" />
                                <TextBlock local:Translate.Key="GPL-2.0 · 基于 Ext4Fsd 驱动协议" Style="{StaticResource SecondaryText}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <TextBlock x:Name="StatusLine" Grid.Row="3" local:Translate.Key="就绪" FontSize="12" Style="{StaticResource SecondaryText}"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
